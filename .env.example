# Configuración del Microservicio NestJS
PORT=3000
NODE_ENV=production

# Llave Maestra Criptográfica (AES-256-GCM) para encriptar CSDs en el servidor
# IMPORTANTE: Definir una cadena secreta de alta entropía (mínimo 32 caracteres)
ENCRYPTION_KEY=peguu-prod-master-key-security-2026-secret-vault-key

# Credenciales del PAC Autorizado de Certificación (Diverza / Timbre Fiscal)
DIVERZA_CLIENT_ID=tu_diverza_client_id
DIVERZA_TOKEN=tu_diverza_token
DIVERZA_STAMP_URL=https://servicios.diverza.com/api/v2/documents/stamp
DIVERZA_CANCEL_URL=https://servicios.diverza.com/api/v2/documents/UUID/cancel

# Ruta segura para el almacenamiento de Certificados de Sello Digital (CSD) y folios encriptados
CSD_STORAGE_PATH=./storage
